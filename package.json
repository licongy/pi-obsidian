{
  "name": "pi-obsidian",
  "version": "0.0.0",
  "description": "A monorepo of independently-published Pi extensions bridging the Pi coding agent and Obsidian.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "licongy",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/licongy/pi-obsidian.git"
  },
  "homepage": "https://github.com/licongy/pi-obsidian#readme",
  "bugs": {
    "url": "https://github.com/licongy/pi-obsidian/issues"
  },
  "keywords": [
    "pi",
    "obsidian",
    "pi-extension",
    "bridge",
    "monorepo"
  ],
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "node scripts/check-clean.mjs && changeset version",
    "release": "node scripts/check-clean.mjs && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
